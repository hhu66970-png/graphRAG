NEO4J_URL=bolt://localhost:7687
NEO4J_USER=neo4j
# 启动前设置自己的密码（至少 8 个字符）；Compose 与应用读取同一值。
NEO4J_PASSWORD=
NEO4J_DB=neo4j

# 默认只允许本机访问；调试模式仅用于本地开发。
BACKEND_HOST=127.0.0.1
BACKEND_PORT=5000
BACKEND_DEBUG=false
BACKEND_MAX_REQUEST_BYTES=65536
# 同源页面不需要 CORS；独立前端可填写允许的来源，以逗号分隔。
CORS_ORIGINS=

# OpenAI-compatible chat completion API
LLM_ENDPOINT=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TOKEN=

# Embedding provider: local, external, or hash (tests only).
EMBED_PROVIDER=local
EMBED_MODEL=BAAI/bge-small-zh-v1.5
EMBED_DEVICE=cpu
# 模型缓存目录使用绝对路径；不支持 ~ 展开。
# Windows 例：D:\ai-models\huggingface   macOS/Linux 例：/home/you/.cache/huggingface
# 留空则交给 huggingface 自行决定（推荐）
EMBED_CACHE_DIR=
EMBED_LOCAL_FILES_ONLY=false
EMBED_QUERY_PREFIX=为这个句子生成表示以用于检索相关文章：
EMBED_ENDPOINT=
EMBED_TOKEN=
EMBED_DIM=512
EMBED_BATCH_SIZE=16

# Intent-aware retrieval budgets (all positive; paths are always capped at 3 hops)
RETRIEVAL_ENTITY_LIMIT=16
RETRIEVAL_DIRECTED_LIMIT=25
RETRIEVAL_COMPARE_FACT_LIMIT=120
RETRIEVAL_COMPARE_CHUNK_LIMIT=80
RETRIEVAL_COMPARE_PER_ENTITY=3
RETRIEVAL_COMPARE_TOTAL=8
RETRIEVAL_PATH_MAX_HOPS=3
RETRIEVAL_PATH_LIMIT=20
RETRIEVAL_TOKEN_BUDGET=4000

CORPUS_PATH=origdata/zhongyaoxue.md
CHUNK_SIZE=900
CHUNK_OVERLAP=120
# 只处理前 N 个文本块，便于首次控制时间与模型费用；0 表示全书
MAX_CHUNKS=30
# 仅旧管线 build_kg_dyn.py 使用；新管线 build_kg_v2.py 走 IngestRun 版本隔离，
# 新管线按批次发布，不清空数据库。
CLEAR_DATABASE=false

# 新管线接受阈值，标定方法见 docs/evaluation.md。
KG_FINAL_ACCEPT=0.80
