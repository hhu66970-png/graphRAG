NEO4J_URL=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=12345678
NEO4J_DB=neo4j

# OpenAI-compatible chat completion API
LLM_ENDPOINT=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TOKEN=

# Embedding provider: local (recommended), external, or hash (demo only).
EMBED_PROVIDER=local
EMBED_MODEL=BAAI/bge-small-zh-v1.5
EMBED_DEVICE=cpu
EMBED_CACHE_DIR=D:\ai-models\huggingface
EMBED_LOCAL_FILES_ONLY=false
EMBED_QUERY_PREFIX=为这个句子生成表示以用于检索相关文章：
EMBED_ENDPOINT=
EMBED_TOKEN=
EMBED_DIM=512
EMBED_BATCH_SIZE=16

CORPUS_PATH=origdata/zhongyaoxue.md
CHUNK_SIZE=900
CHUNK_OVERLAP=120
MAX_CHUNKS=30
CLEAR_DATABASE=true
